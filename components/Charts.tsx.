export const JawsOfDeathChart: React.FC<ChartProps> = ({ metrics }) => {
  const data = [
    { name: 'SGR (Sustainable)', value: parseFloat(metrics.sgr.toFixed(1)), fill: '#06b6d4' },
    { name: 'AGR (Actual)', value: parseFloat(metrics.agr.toFixed(1)), fill: metrics.agr > metrics.sgr ? '#ef4444' : '#10b981' },
  ];

  return (
    <div className="h-64 w-full">
      <ResponsiveContainer width="100%" height="100%">
        <BarChart layout="vertical" data={data} margin={{ top: 20, right: 30, left: 40, bottom: 5 }}>
          <CartesianGrid strokeDasharray="3 3" horizontal={false} stroke="#334155" />
          <XAxis type="number" stroke="#94a3b8" unit="%" />
          <YAxis dataKey="name" type="category" stroke="#94a3b8" width={100} tick={{fontSize: 11}} />
          <Tooltip 
            contentStyle={{ backgroundColor: '#1e293b', borderColor: '#334155' }}
            itemStyle={{ color: '#f8fafc' }}
          />
          <Bar dataKey="value" barSize={30} radius={[0, 4, 4, 0]} />
        </BarChart>
      </ResponsiveContainer>
    </div>
  );
};

export const KPIRadarChart: React.FC<ChartProps> = ({ metrics }) => {
  // Normalize metrics for Radar Chart (0-100 scale approximately)
  // We clamp values to make the chart readable
  const data = [
    { subject: 'ROE', A: Math.min(metrics.roe * 2, 100), fullMark: 100 },
    { subject: 'Net Margin', A: Math.min(metrics.netMargin * 2, 100), fullMark: 100 },
    { subject: 'FCF Margin', A: Math.min(metrics.fcfMargin * 2, 100), fullMark: 100 },
    { subject: 'AGR', A: Math.min(metrics.agr * 2, 100), fullMark: 100 },
    { subject: 'FCF/NI', A: Math.min(metrics.fcfToNetIncome * 50, 100), fullMark: 100 },
  ];

  return (
    <div className="h-64 w-full">
      <ResponsiveContainer width="100%" height="100%">
        <RadarChart cx="50%" cy="50%" outerRadius="70%" data={data}>
          <PolarGrid stroke="#334155" />
          <PolarAngleAxis dataKey="subject" tick={{ fill: '#94a3b8', fontSize: 11 }} />
          <PolarRadiusAxis angle={30} domain={[0, 100]} tick={false} axisLine={false} />
          <Radar
            name="Company Metrics"
            dataKey="A"
            stroke="#8b5cf6"
            strokeWidth={2}
            fill="#8b5cf6"
            fillOpacity={0.4}
          />
          <Tooltip content={<CustomTooltip />} />
        </RadarChart>
      </ResponsiveContainer>
    </div>
  );
};